# Vorlage für die spätere Shopify-Anbindung.
# Bei der Integration nach .env.local kopieren und dort echte Werte eintragen.
# Die aktuelle Landingpage benötigt diese Einstellungen noch nicht.

# Shopify-Domain ohne https:// und ohne abschließenden Schrägstrich.
# Beispiel: dein-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Festgelegte Storefront-API-Version; vor der Integration erneut prüfen.
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Privater Storefront-Token für Anfragen vom Next.js-Server.
# Kein Admin-API-Token. Nicht mit NEXT_PUBLIC_ veröffentlichen.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
